# FreshRescue Backend Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="FreshRescue"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Default local SQLite async for testing, or Supabase PostgreSQL asyncpg
DATABASE_URL="sqlite+aiosqlite:///./freshrescue.db"
# DATABASE_URL="postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres"

# Supabase Auth & Storage (optional if running standalone SQLite)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Security & Local JWT
JWT_SECRET="freshrescue-secret-super-secure-key-2026-production-grade"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API
# Add your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
